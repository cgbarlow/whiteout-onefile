{
 "query": "seed=7713&dynres=0",
 "w": 1280,
 "h": 720,
 "steps": [
  {
   "waitFor": "__G.mods.ui && __G.mods.ui.state === 'title' && __G.mods.game && __G.mods.game.debug",
   "timeout": 120000,
   "msg": "boots to the title screen"
  },
  {
   "assert": "__stats().modules.every(m => m.ok && !m.stub) && __stats().stubs === 0",
   "msg": "every boot stage ok (no stubs)"
  },
  {
   "assert": "__G.quality.tier && __G.quality.scale > 0 && !/swiftshader|llvmpipe/i.test(__stats().renderer)",
   "msg": "real GPU, quality tier detected"
  },
  {
   "assert": "__G.warmupStats && !__G.warmupStats.timedOut && __G.readyPrograms > 0",
   "msg": "shader warm-up finished"
  },
  {
   "eval": "__G.camera.position.toArray()",
   "as": "c0"
  },
  {
   "wait": 1500
  },
  {
   "assert": "__G.paused && __G.camera.position.distanceTo(new __G.camera.position.constructor().fromArray(__pt.c0)) > 0.5",
   "msg": "title: live PATH flyover moves the camera while the game is paused"
  },
  {
   "waitFor": "__G.mods.audio.stats.ready",
   "timeout": 90000,
   "msg": "audio bank rendered"
  },
  {
   "assert": "__G.mods.audio.stats.failed === 0 && __G.mods.audio.stats.peakDb <= -1 && __G.mods.audio.stats.buffers > 0",
   "msg": "audio self-test: every stem metered, peak <= -1 dBFS"
  },
  {
   "eval": "JSON.stringify(__G.mods.audio.stats)",
   "as": "audio"
  },
  {
   "eval": "(document.querySelector('#title [data-act=\"settings\"]').click(), 1)"
  },
  {
   "waitFor": "__G.mods.ui.state === 'settings'",
   "timeout": 10000,
   "msg": "title \u2192 settings"
  },
  {
   "eval": "(() => { const f = document.querySelector('#settings form').elements; f.fov.value = 80; f.sens.value = 1.4; f.invertY.checked = true; f.fov.form.dispatchEvent(new Event('input')); return 1; })()"
  },
  {
   "waitFor": "Math.abs(__G.camera.fov - 80) < 0.01 && __G.mods.input.invertY === true",
   "timeout": 10000,
   "msg": "settings apply FOV + invert Y"
  },
  {
   "eval": "(() => { const f = document.querySelector('#settings form').elements; f.fov.value = 68; f.sens.value = 1; f.invertY.checked = false; f.fov.form.dispatchEvent(new Event('input')); return 1; })()"
  },
  {
   "eval": "(document.querySelector('#settings [data-act=\"back\"]').click(), 1)"
  },
  {
   "waitFor": "__G.mods.ui.state === 'title'",
   "timeout": 10000,
   "msg": "settings back \u2192 title"
  },
  {
   "click": [
    137,
    534
   ]
  },
  {
   "waitFor": "__G.mods.ui.state === 'playing' && !__G.paused && __G.mods.game.state === 'playing'",
   "timeout": 15000,
   "msg": "real click on Start \u2192 playing"
  },
  {
   "wait": 1500
  },
  {
   "assert": "__stats().input.locked || __stats().input.mode === 'drag'",
   "msg": "pointer lock taken, or the drag fallback is active"
  },
  {
   "eval": "JSON.stringify(__stats().input)",
   "as": "inputMode"
  },
  {
   "assert": "Math.hypot(__G.mods.player.position.x - 44, __G.mods.player.position.z - 12) < 1.5",
   "msg": "start puts the player at the shed spawn"
  },
  {
   "eval": "(window.__ev = { steps: 0, noise: 0, start: 0, end: [] }, __G.on('player:step', () => __ev.steps++), __G.on('noise', () => __ev.noise++), __G.on('game:start', () => __ev.start++), __G.on('game:end', (r) => __ev.end.push(r)), __G.mods.game.debug.peace = true, 1)",
   "as": "listeners"
  },
  {
   "eval": "__G.mods.player.position.toArray()",
   "as": "p0"
  },
  {
   "eval": "(__input.hold('forward', 1500), 1)"
  },
  {
   "waitFor": "Math.hypot(__G.mods.player.position.x - __pt.p0[0], __G.mods.player.position.z - __pt.p0[2]) > 2",
   "timeout": 30000,
   "msg": "W walks the player > 2 m"
  },
  {
   "waitFor": "__ev.steps >= 3 && __ev.noise >= 2",
   "timeout": 30000,
   "msg": "footfalls emit player:step + noise"
  },
  {
   "eval": "__G.mods.player.yaw",
   "as": "yaw0"
  },
  {
   "look": [
    300,
    0
   ]
  },
  {
   "waitFor": "Math.abs(__G.mods.player.yaw - __pt.yaw0) > 0.3",
   "timeout": 15000,
   "msg": "mouse look turns the player"
  },
  {
   "eval": "(__input.hold('forward', 2500), __input.hold('sprint', 2500), 1)"
  },
  {
   "waitFor": "__G.mods.player.sprinting && __G.mods.player.speed > 4.5",
   "timeout": 30000,
   "msg": "Shift sprints (> 4.5 m/s)"
  },
  {
   "waitFor": "__G.mods.player.stamina < 0.85",
   "timeout": 30000,
   "msg": "sprinting drains stamina"
  },
  {
   "waitFor": "!__G.mods.player.sprinting && __G.mods.player.speed < 0.3",
   "timeout": 30000
  },
  {
   "eval": "(__input.hold('crouch', 2500), 1)"
  },
  {
   "waitFor": "__G.mods.player.crouching && __G.mods.player.eye < 1.2",
   "timeout": 30000,
   "msg": "C crouches (eye drops)"
  },
  {
   "waitFor": "!__G.mods.player.crouching",
   "timeout": 30000
  },
  {
   "press": "jump",
   "after": 50
  },
  {
   "waitFor": "!__G.mods.player.grounded",
   "timeout": 15000,
   "msg": "Space jumps"
  },
  {
   "waitFor": "__G.mods.player.grounded",
   "timeout": 15000,
   "msg": "lands again"
  },
  {
   "press": "light",
   "after": 300
  },
  {
   "waitFor": "__G.mods.flashlight.on === false",
   "timeout": 15000,
   "msg": "F toggles the torch off"
  },
  {
   "press": "light",
   "after": 300
  },
  {
   "waitFor": "__G.mods.flashlight.on === true",
   "timeout": 15000,
   "msg": "F toggles the torch on"
  },
  {
   "eval": "__G.mods.game.debug.tp('lab')"
  },
  {
   "eval": "(__input.hold('crouch', 4000), 1)"
  },
  {
   "waitFor": "__G.mods.game.hidden === true && __G.mods.game.prompt === 'Hidden'",
   "timeout": 30000,
   "msg": "crouching inside the lab hides the player"
  },
  {
   "waitFor": "!__G.mods.player.crouching",
   "timeout": 30000
  },
  {
   "eval": "__G.mods.game.debug.tp('shed')"
  },
  {
   "waitFor": "__G.mods.game.prompt === 'Hold C  hide'",
   "timeout": 15000,
   "msg": "the vehicle shed is a hide zone"
  },
  {
   "eval": "(__G.mods.flashlight.battery = 0.3, __G.mods.game.debug.tp('cell1'))"
  },
  {
   "waitFor": "__G.mods.game.inter.kind === 'cell'",
   "timeout": 15000,
   "msg": "lab dock cell in reach"
  },
  {
   "press": "interact",
   "after": 200
  },
  {
   "waitFor": "__G.mods.flashlight.battery > 0.95 && __G.mods.game.pickups.cells[1].taken",
   "timeout": 15000,
   "msg": "E swaps in the lab cell (battery refilled)"
  },
  {
   "eval": "(__G.mods.flashlight.battery = 0.4, __G.mods.game.debug.tp('cell2'))"
  },
  {
   "waitFor": "__G.mods.game.inter.kind === 'cell'",
   "timeout": 15000,
   "msg": "mess wall-charger cell in reach"
  },
  {
   "press": "interact",
   "after": 200
  },
  {
   "waitFor": "__G.mods.flashlight.battery > 0.95 && __G.mods.game.pickups.cells[2].taken",
   "timeout": 15000,
   "msg": "E swaps in the charger cell"
  },
  {
   "eval": "__G.mods.game.debug.tp('cell0') && __G.mods.game.debug.tp('cell3')"
  },
  {
   "eval": "__G.mods.game.debug.stage('beam')"
  },
  {
   "waitFor": "__G.mods.stalker.state === 'stagger' || __G.mods.stalker.state === 'retreat'",
   "timeout": 30000,
   "msg": "holding the beam on the stalker staggers it"
  },
  {
   "waitFor": "__G.mods.stalker.state === 'retreat'",
   "timeout": 30000,
   "msg": "then it retreats"
  },
  {
   "assert": "__G.mods.game.state === 'playing'",
   "msg": "the beam saved the player"
  },
  {
   "eval": "(__G.mods.stalker.reset(), __G.mods.game.debug.peace = true, 1)"
  },
  {
   "eval": "__G.mods.game.debug.tp('genA')"
  },
  {
   "waitFor": "__G.mods.game.inter.kind === 'gen' && __G.mods.game.prompt.includes('GEN A')",
   "timeout": 15000,
   "msg": "GEN A panel in reach"
  },
  {
   "hold": "interact",
   "ms": 3800
  },
  {
   "waitFor": "__G.mods.generators.list[0].state === 'running'",
   "timeout": 90000,
   "msg": "holding E cranks GEN A to running"
  },
  {
   "assert": "__G.mods.game.gens === 1 && __G.mods.game.objective.includes('1/3')",
   "msg": "objective counts 1/3"
  },
  {
   "press": "pause",
   "after": 300
  },
  {
   "waitFor": "__G.mods.ui.state === 'paused' && __G.paused",
   "timeout": 15000,
   "msg": "P pauses"
  },
  {
   "eval": "__G.mods.game.time",
   "as": "tPause"
  },
  {
   "wait": 800
  },
  {
   "assert": "__G.mods.game.time === __pt.tPause",
   "msg": "game time frozen while paused"
  },
  {
   "eval": "(document.querySelector('#pause [data-act=\"settings\"]').click(), 1)"
  },
  {
   "waitFor": "__G.mods.ui.state === 'settings'",
   "timeout": 10000,
   "msg": "pause \u2192 settings"
  },
  {
   "eval": "(() => { const f = document.querySelector('#settings form').elements; f.volume.value = 0.5; f.brightness.value = 1.1; f.fov.form.dispatchEvent(new Event('input')); return 1; })()"
  },
  {
   "eval": "(document.querySelector('#settings [data-act=\"back\"]').click(), 1)"
  },
  {
   "waitFor": "__G.mods.ui.state === 'paused'",
   "timeout": 10000,
   "msg": "settings back \u2192 pause"
  },
  {
   "eval": "(document.querySelector('#pause [data-act=\"resume\"]').click(), 1)"
  },
  {
   "waitFor": "__G.mods.ui.state === 'playing' && !__G.paused",
   "timeout": 15000,
   "msg": "Resume \u2192 playing"
  },
  {
   "eval": "(() => { const f = document.querySelector('#settings form').elements; f.volume.value = 0.8; f.brightness.value = 1; f.fov.form.dispatchEvent(new Event('input')); return 1; })()"
  },
  {
   "shot": "after-crank"
  },
  {
   "eval": "__G.mods.game.debug.tp('genB')"
  },
  {
   "waitFor": "__G.mods.game.inter.kind === 'gen' && __G.mods.game.prompt.includes('GEN B')",
   "timeout": 15000,
   "msg": "GEN B panel in reach"
  },
  {
   "hold": "interact",
   "ms": 3800
  },
  {
   "waitFor": "__G.mods.generators.list[1].state === 'running'",
   "timeout": 90000,
   "msg": "GEN B running"
  },
  {
   "eval": "__G.mods.game.debug.tp('genC')"
  },
  {
   "waitFor": "__G.mods.game.inter.kind === 'gen' && __G.mods.game.prompt.includes('GEN C')",
   "timeout": 15000,
   "msg": "GEN C panel in reach"
  },
  {
   "hold": "interact",
   "ms": 3800
  },
  {
   "waitFor": "__G.mods.generators.list[2].state === 'running'",
   "timeout": 90000,
   "msg": "GEN C running"
  },
  {
   "waitFor": "__G.mods.generators.beacon.powered && __G.mods.game.gens === 3 && __G.mods.game.objective.includes('radio hut')",
   "timeout": 15000,
   "msg": "3/3: the beacon powers on"
  },
  {
   "eval": "__G.mods.game.debug.tp('console')"
  },
  {
   "waitFor": "__G.mods.game.inter.kind === 'console' && __G.mods.game.prompt.includes('extraction')",
   "timeout": 15000,
   "msg": "radio console in reach, call offered"
  },
  {
   "hold": "interact",
   "ms": 5800
  },
  {
   "waitFor": "__G.mods.game.state === 'won'",
   "timeout": 120000,
   "msg": "a 5 s hold at the console wins"
  },
  {
   "waitFor": "__G.mods.ui.state === 'end' && __ev.end[0] === 'won'",
   "timeout": 30000,
   "msg": "game:end won \u2192 end screen"
  },
  {
   "shot": "won"
  },
  {
   "eval": "(document.querySelector('[data-act=\"restart\"]').click(), 1)"
  },
  {
   "waitFor": "__G.mods.ui.state === 'playing' && __G.mods.game.state === 'playing'",
   "timeout": 30000,
   "msg": "restart button \u2192 playing"
  },
  {
   "assert": "__G.mods.game.gens === 0 && !__G.mods.generators.beacon.powered && __G.mods.game.time < 5 && __G.mods.game.pickups.cells.every(c => !c.taken)",
   "msg": "restart resets generators, beacon, timer, cells"
  },
  {
   "assert": "Math.hypot(__G.mods.player.position.x - 44, __G.mods.player.position.z - 12) < 1.5 && __ev.start >= 1",
   "msg": "restart puts the player at spawn + game:start"
  },
  {
   "eval": "__G.mods.game.debug.stage('catch')"
  },
  {
   "waitFor": "__G.mods.game.state === 'lost'",
   "timeout": 60000,
   "msg": "the stalker catches an unarmed player"
  },
  {
   "waitFor": "__G.mods.ui.state === 'end' && __ev.end[1] === 'lost'",
   "timeout": 30000,
   "msg": "game:end lost \u2192 end screen"
  },
  {
   "shot": "lost"
  },
  {
   "eval": "(document.querySelector('[data-act=\"restart\"]').click(), 1)"
  },
  {
   "waitFor": "__G.mods.ui.state === 'playing' && __G.mods.game.state === 'playing' && __G.mods.stalker.state !== 'chase'",
   "timeout": 30000,
   "msg": "restart after a loss"
  },
  {
   "assert": "__ev.start >= 2 && !__G.mods.stalker.caught",
   "msg": "second restart clean"
  },
  {
   "wait": 2000
  },
  {
   "shot": "restarted"
  },
  {
   "assert": "__G.mods.game.state === 'playing' && !__G.paused && __G.mods.game.time > 1",
   "msg": "the restarted run is live (clock running)"
  },
  {
   "eval": "({ ms: __stats().gameMs, max: __stats().gameMsMax })",
   "as": "gameMs"
  },
  {
   "assert": "__stats().gameMs < 0.3",
   "msg": "game update \u2264 0.3 ms/frame (avg)"
  },
  {
   "eval": "({ now: __G.renderer.info.programs.length, ready: __G.readyPrograms, tier: __G.quality.tier })",
   "as": "programs"
  },
  {
   "assert": "__G.renderer.info.programs.length <= __G.readyPrograms",
   "msg": "no shader compiled after ready (warm-up covered every permutation)"
  },
  {
   "assert": "__stats().calls > 0 && __stats().tris > 0 && __stats().errors === 0",
   "msg": "renders geometry, zero errors"
  }
 ]
}